#!/bin/bash
# lockdown-allow <ip> <user> <days>
#
# Adds one IP address to the firewalld "trusted" zone and records when it expires.
# Runs as root through sudo; it is the ONLY thing the web server may run as root,
# so every argument is checked here again, whatever the PHP side already did.
#
# Exit codes: 0 ok, 2 bad arguments, 3 runtime add failed, 4 permanent add failed, 5 list not written.

set -u
PATH=/usr/sbin:/usr/bin:/sbin:/bin
ZONE=trusted
DIR=/var/lib/lockdown
LIST=$DIR/allowed.list
LOCK=$DIR/.allowed.lock

ip="${1:-}"
user="${2:-}"
days="${3:-7}"

valid_ip() {
    local a="$1" o
    if [[ "$a" =~ ^([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})$ ]]; then
        for o in "${BASH_REMATCH[@]:1}"; do
            [ "$((10#$o))" -le 255 ] || return 1
        done
        return 0
    fi
    # IPv6: hex and colons only, no prefix length. firewalld rejects anything malformed.
    [[ "$a" == *:* && "$a" =~ ^[0-9A-Fa-f:]{2,39}$ ]]
}

# A single address only: no "/" means no ranges, so 0.0.0.0/0 can never get in.
valid_ip "$ip"                          || { echo "bad ip" >&2; exit 2; }
[[ "$user" =~ ^[A-Za-z0-9_-]{1,20}$ ]]  || { echo "bad user" >&2; exit 2; }
[[ "$days" =~ ^[0-9]{1,3}$ ]] && [ "$days" -ge 1 ] && [ "$days" -le 365 ] || { echo "bad days" >&2; exit 2; }

in_zone() {   # $1 is "" (runtime) or --permanent
    firewall-cmd $1 --zone="$ZONE" --query-source="$ip" >/dev/null 2>&1
}
in_list() {
    [ -f "$LIST" ] && awk -v ip="$ip" '$1 == ip { found = 1 } END { exit !found }' "$LIST"
}

# An IP that is already permanent but not in our list was put there by an admin
# (office line, another cluster server). Record it with no expiry so it is never removed.
expires=$(( $(date +%s) + days * 86400 ))
if in_zone --permanent && ! in_list; then
    expires=0
fi

in_zone ""          || firewall-cmd --zone="$ZONE" --add-source="$ip" >/dev/null 2>&1             || { echo "runtime add failed" >&2; exit 3; }
in_zone --permanent || firewall-cmd --permanent --zone="$ZONE" --add-source="$ip" >/dev/null 2>&1 || { echo "permanent add failed" >&2; exit 4; }

mkdir -p "$DIR" || exit 5
(
    flock -x 9 || exit 1
    tmp=$(mktemp "$LIST.XXXXXX") || exit 1
    if [ -f "$LIST" ]; then
        # keep an existing "no expiry" entry as it is
        if awk -v ip="$ip" '$1 == ip && $2 == 0 { found = 1 } END { exit !found }' "$LIST"; then
            expires=0
        fi
        awk -v ip="$ip" '$1 != ip' "$LIST" > "$tmp"
    fi
    printf '%s %s %s\n' "$ip" "$expires" "$user" >> "$tmp"
    chmod 644 "$tmp" && mv -f "$tmp" "$LIST"
) 9>"$LOCK" || { echo "allow list not written" >&2; exit 5; }

logger -t lockdown "allowed $ip for $user (expires $expires)" 2>/dev/null
exit 0
